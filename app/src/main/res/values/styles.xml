<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Kolom input Green Note: latar krem, sudut bulat, tanpa garis (ikut Figma) -->
    <style name="Widget.GreenNote.TextInput" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/green_note_cream</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/green_note_primary</item>
    </style>

    <!-- Tombol utama Green Note: terakota, bentuk kapsul -->
    <style name="Widget.GreenNote.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/green_note_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <!-- Teks Toolbar: judul Domine, subjudul kecil terakota (ikut header Figma) -->
    <style name="TextAppearance.GreenNote.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/domine_bold</item>
        <item name="fontFamily">@font/domine_bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.GreenNote.ToolbarSubtitle" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <!-- Label bottom nav: 10sp tebal seperti Figma -->
    <style name="TextAppearance.GreenNote.NavLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!-- Pill di belakang ikon aktif dibuat transparan, Figma cuma mengganti warna -->
    <style name="Widget.GreenNote.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <!-- Chip kategori: warnanya dari res/color/chip_*.xml, tanpa ikon centang -->
    <style name="TextAppearance.GreenNote.Chip" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.GreenNote.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textAppearance">@style/TextAppearance.GreenNote.Chip</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>
</resources>
