<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Kolom input Green Note: latar krem, sudut bulat, tanpa garis (ikut Figma) -->
    <style name="Widget.GreenNote.TextInput" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/green_note_cream</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/green_note_primary</item>
    </style>

    <!-- Tombol utama Green Note: terakota, bentuk kapsul -->
    <style name="Widget.GreenNote.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/green_note_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">28dp</item>
    </style>
</resources>
