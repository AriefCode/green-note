<?xml version="1.0" encoding="utf-8"?>
<!-- satu kartu catatan di Jurnal Botani (data dari tabel catatan_flora) -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/green_note_cream"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvNamaPopuler"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/domine_bold"
            android:text="nama_populer"
            android:textColor="@color/green_note_text_primary"
            android:textSize="17sp"
            app:layout_constraintEnd_toStartOf="@id/btnDelete"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- tombol hapus di kanan atas -->
        <ImageView
            android:id="@+id/btnDelete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Hapus catatan"
            android:padding="12dp"
            android:src="@drawable/ic_delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/green_note_danger" />

        <TextView
            android:id="@+id/tvNamaLatin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:text="nama_latin"
            android:textColor="@color/green_note_primary"
            android:textSize="13sp"
            android:textStyle="italic"
            app:layout_constraintEnd_toStartOf="@id/btnDelete"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNamaPopuler" />

        <!-- badge kategori: background pill yang sudah ada -->
        <TextView
            android:id="@+id/tvKategori"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pill_peach"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="kategori"
            android:textColor="@color/green_note_primary"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNamaLatin" />

        <TextView
            android:id="@+id/tvLokasiTanggal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:text="lokasi • tanggal"
            android:textColor="@color/green_note_text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvKategori" />

        <!-- jurnal maksimal 2 baris, sisanya jadi "..." -->
        <TextView
            android:id="@+id/tvJurnal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:maxLines="2"
            android:text="jurnal"
            android:textColor="@color/green_note_text_primary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLokasiTanggal" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
