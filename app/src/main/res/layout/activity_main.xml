<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green_note_background"
    tools:context=".MainActivity">

    <!-- satu Toolbar untuk semua tab, judulnya diganti per tab -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/green_note_background"
        android:elevation="2dp"
        android:theme="@style/ThemeOverlay.Material3.ActionBar"
        app:contentInsetStart="20dp"
        app:logo="@drawable/logo_toolbar"
        app:logoDescription="Logo Green Note"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/ThemeOverlay.Material3.Light"
        app:subtitleTextAppearance="@style/TextAppearance.GreenNote.ToolbarSubtitle"
        app:subtitleTextColor="@color/green_note_primary"
        app:titleMarginStart="8dp"
        app:titleTextAppearance="@style/TextAppearance.GreenNote.ToolbarTitle"
        app:titleTextColor="@color/green_note_secondary" />

    <!-- wadah fragment, isinya diganti lewat replaceFragment() -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:itemActiveIndicatorStyle="@style/Widget.GreenNote.NavIndicator"
        app:itemIconTint="@color/bottom_nav_item"
        app:itemTextAppearanceActive="@style/TextAppearance.GreenNote.NavLabel"
        app:itemTextAppearanceInactive="@style/TextAppearance.GreenNote.NavLabel"
        app:itemTextColor="@color/bottom_nav_item"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
