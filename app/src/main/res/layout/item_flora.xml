<?xml version="1.0" encoding="utf-8"?>
<!-- tampilan SATU baris di ListView Koleksi (dipakai FloraAdapter) -->
<!-- FrameLayout luar dipakai sebagai jarak antar kartu, karena margin item ListView diabaikan -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/textKategori"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/green_note_sand"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="Kategori"
                android:textAllCaps="true"
                android:textColor="@color/green_note_secondary"
                android:textSize="10sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/imgFlora"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_marginTop="12dp"
                android:background="@color/green_note_sand"
                android:contentDescription="Foto flora"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textKategori" />

            <TextView
                android:id="@+id/textNama"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/domine_bold"
                android:text="Nama Flora"
                android:textColor="@color/green_note_text_primary"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imgFlora" />

            <TextView
                android:id="@+id/textNamaLatin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Nama latin"
                android:textColor="@color/green_note_primary"
                android:textSize="12sp"
                android:textStyle="italic"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textNama" />

            <TextView
                android:id="@+id/textLokasi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="4dp"
                android:background="@color/green_note_sand"
                android:padding="10dp"
                android:text="Lokasi"
                android:textColor="@color/green_note_text_primary"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@+id/textTanggal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textNamaLatin" />

            <TextView
                android:id="@+id/textTanggal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@color/green_note_sand"
                android:padding="10dp"
                android:text="Tanggal"
                android:textColor="@color/green_note_text_primary"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/textLokasi"
                app:layout_constraintTop_toTopOf="@+id/textLokasi" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
