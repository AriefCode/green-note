<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green_note_background"
    tools:context=".DetailFloraActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/green_note_background">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/green_note_background"
            android:theme="@style/ThemeOverlay.Material3.ActionBar"
            app:subtitleTextAppearance="@style/TextAppearance.GreenNote.ToolbarSubtitle"
            app:subtitleTextColor="@color/green_note_primary"
            app:titleTextAppearance="@style/TextAppearance.GreenNote.ToolbarTitle"
            app:titleTextColor="@color/green_note_secondary" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- layout_behavior: isi otomatis ditaruh di bawah AppBarLayout -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- 1. foto besar + badge kondisi di atasnya -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:contentPadding="10dp"
                app:strokeWidth="0dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/green_note_cream"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/imgFlora"
                        android:layout_width="match_parent"
                        android:layout_height="400dp"
                        android:contentDescription="Foto flora"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/textBadgeKondisi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_pill_white"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/green_note_primary"
                        android:textSize="10sp" />
                </com.google.android.material.card.MaterialCardView>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. identitas: nama, nama latin, kategori -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_rounded_cream"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textNama"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/domine_bold"
                    android:textColor="@color/green_note_secondary"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/textNamaLatin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/domine_bold"
                    android:textColor="@color/green_note_primary"
                    android:textSize="18sp"
                    android:textStyle="italic" />

                <TextView
                    android:id="@+id/textKategori"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_pill_orange"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/green_note_text_primary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 3. kartu catatan observasi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_rounded_white"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_circle_sand_dark"
                        android:contentDescription="@null"
                        android:padding="7dp"
                        app:srcCompat="@drawable/ic_note"
                        app:tint="@color/green_note_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="Catatan Observasi Lapangan"
                        android:textColor="@color/green_note_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- FrameLayout: garis terakota ditumpuk di sisi kiri kotak catatan -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_rounded_cream">

                    <TextView
                        android:id="@+id/textCatatan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/domine_bold"
                        android:lineSpacingExtra="6dp"
                        android:paddingStart="16dp"
                        android:paddingTop="13dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="14dp"
                        android:textColor="@color/green_note_secondary"
                        android:textSize="16sp" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="12dp"
                        android:background="@color/green_note_primary" />
                </FrameLayout>
            </LinearLayout>

            <!-- 4. grid info 2x2: dua baris, tiap baris dua kotak -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_rounded_cream"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_circle_sand_dark"
                        android:contentDescription="@null"
                        android:padding="7dp"
                        app:srcCompat="@drawable/ic_location"
                        app:tint="@color/green_note_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="Arsip Temuan"
                        android:textColor="@color/green_note_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rounded_white"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:contentDescription="@null"
                                app:srcCompat="@drawable/ic_location"
                                app:tint="@color/green_note_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:fontFamily="@font/plus_jakarta_sans_bold"
                                android:letterSpacing="0.05"
                                android:text="LOKASI"
                                android:textColor="@color/green_note_primary"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textLokasi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:textColor="@color/green_note_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rounded_white"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:contentDescription="@null"
                                app:srcCompat="@drawable/ic_calendar"
                                app:tint="@color/green_note_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:fontFamily="@font/plus_jakarta_sans_bold"
                                android:letterSpacing="0.05"
                                android:text="TANGGAL"
                                android:textColor="@color/green_note_primary"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textTanggal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:textColor="@color/green_note_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rounded_white"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:contentDescription="@null"
                                app:srcCompat="@drawable/ic_leaf"
                                app:tint="@color/green_note_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:fontFamily="@font/plus_jakarta_sans_bold"
                                android:letterSpacing="0.05"
                                android:text="KATEGORI"
                                android:textColor="@color/green_note_primary"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textInfoKategori"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:textColor="@color/green_note_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rounded_white"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:contentDescription="@null"
                                app:srcCompat="@drawable/ic_water"
                                app:tint="@color/green_note_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:fontFamily="@font/plus_jakarta_sans_bold"
                                android:letterSpacing="0.05"
                                android:text="KONDISI"
                                android:textColor="@color/green_note_primary"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textInfoKondisi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:textColor="@color/green_note_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 5. tombol aksi -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                style="@style/Widget.GreenNote.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Edit Lembar Catatan"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_edit"
                app:iconGravity="textStart"
                app:iconTint="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWikipedia"
                style="@style/Widget.GreenNote.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Baca di Wikipedia"
                android:textColor="@color/green_note_secondary"
                app:backgroundTint="@color/green_note_sand_muted"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_book"
                app:iconGravity="textStart"
                app:iconTint="@color/green_note_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHapus"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="Hapus Spesimen dari Herbarium"
                android:textAllCaps="false"
                android:textColor="@color/green_note_danger"
                android:textSize="12sp"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconTint="@color/green_note_danger" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
