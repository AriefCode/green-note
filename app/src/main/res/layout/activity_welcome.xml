<?xml version="1.0" encoding="utf-8"?>
<!-- Halaman Selamat Datang (frame Figma). ScrollView untuk layar yang lebih pendek dari desain -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green_note_background"
    android:fillViewport="true"
    tools:context=".WelcomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <!-- baris label paling atas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_sand_dark"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:letterSpacing="0.05"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="GN-HERBARIUM"
                android:textColor="@color/green_note_text_secondary"
                android:textSize="10sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_sand"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:letterSpacing="0.1"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="VOL. 01 • EDISI 2025"
                android:textColor="@color/green_note_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- hero: anak FrameLayout ditumpuk, yang ditulis belakangan tampil paling atas -->
        <FrameLayout
            android:layout_width="288dp"
            android:layout_height="288dp"
            android:layout_marginTop="16dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.4"
                android:background="@drawable/bg_circle_sand_dark" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="22dp"
                android:alpha="0.7"
                android:background="@drawable/bg_circle_sand" />

            <!-- bingkai lengkung -->
            <LinearLayout
                android:layout_width="224dp"
                android:layout_height="256dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_arch_white"
                android:elevation="8dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:letterSpacing="0.1"
                    android:text="ARSIP Nº 04"
                    android:textColor="@color/green_note_text_secondary"
                    android:textSize="10sp" />

                <!-- weight 1: logo mengisi sisa tinggi di antara judul dan plat bawah -->
                <ImageView
                    android:id="@+id/imgLogo"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="Logo Green Note"
                    app:srcCompat="@drawable/logo_green_note" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_cream"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/domine_bold"
                        android:text="Flora &amp;\nFolia"
                        android:textColor="@color/green_note_secondary"
                        android:textSize="16sp"
                        android:textStyle="italic" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:letterSpacing="0.1"
                        android:text="100%\nPERSONAL"
                        android:textColor="@color/green_note_primary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- dua label miring; elevation lebih tinggi supaya tampil di atas bingkai -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_pill_peach"
                android:elevation="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:rotation="-8">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_leaf"
                    app:tint="@color/green_note_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:letterSpacing="0.06"
                    android:text="TAKSONOMI"
                    android:textColor="@color/green_note_primary"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_pill_sand"
                android:elevation="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:rotation="6">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_herbarium"
                    app:tint="@color/green_note_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:letterSpacing="0.06"
                    android:text="HERBARIUM"
                    android:textColor="@color/green_note_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- judul dan narasi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pill_peach"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:letterSpacing="0.1"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="JURNAL &amp; ARSIP BOTANI PERSONAL"
            android:textColor="@color/green_note_primary"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/domine_bold"
            android:text="Green Note"
            android:textColor="@color/green_note_text_primary"
            android:textSize="30sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/domine_bold"
            android:gravity="center"
            android:text="“Catat setiap hijau di sekitarmu.”"
            android:textColor="@color/green_note_primary"
            android:textSize="18sp"
            android:textStyle="italic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:maxWidth="320dp"
            android:text="Abadikan daun yang menyapa pagi, simpan kisah mekarnya kelopak, dan rangkai ensiklopedia pribadimu lembar demi lembar."
            android:textColor="@color/green_note_text_secondary"
            android:textSize="14sp" />

        <!-- tiga kartu fitur, weight 1 supaya lebarnya sama -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_card_white"
            android:elevation="1dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_sand"
                android:contentDescription="@null"
                android:padding="11dp"
                app:srcCompat="@drawable/ic_camera"
                app:tint="@color/green_note_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:gravity="center"
                android:text="Potret &amp; Deteksi"
                android:textColor="@color/green_note_text_primary"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="Identifikasi"
                android:textColor="@color/green_note_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_white"
            android:elevation="1dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_sand"
                android:contentDescription="@null"
                android:padding="11dp"
                app:srcCompat="@drawable/ic_book"
                app:tint="@color/green_note_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:gravity="center"
                android:text="Katalog Harian"
                android:textColor="@color/green_note_text_primary"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="Catatan visual"
                android:textColor="@color/green_note_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_white"
            android:elevation="1dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_sand"
                android:contentDescription="@null"
                android:padding="11dp"
                app:srcCompat="@drawable/ic_pot"
                app:tint="@color/green_note_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:gravity="center"
                android:text="Pantau Tunas"
                android:textColor="@color/green_note_text_primary"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="Siklus siram"
                android:textColor="@color/green_note_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
        </LinearLayout>

        <!-- icon + iconGravity: panah ditaruh setelah teks tombol -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMulai"
            style="@style/Widget.GreenNote.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Mulai Menjelajah"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd"
            app:iconTint="@color/white" />

        <LinearLayout
            android:id="@+id/layoutKeLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sudah punya jurnal botani? "
                android:textColor="@color/green_note_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/link_masuk"
                android:textColor="@color/green_note_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0.75"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:text="DIBUAT DENGAN CINTA UNTUK PARA PENGAMAT ALAM • VOL. 01"
            android:textColor="@color/green_note_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
